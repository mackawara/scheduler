NODE_ENV=development
PORT=4100
MONGODB_URI=mongodb://localhost:27017/scheduler?replicaSet=rs0
REDIS_URL=redis://localhost:6379
# Generate with: openssl rand -base64 32
PII_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
# Generate with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
DEV_EXPOSE_OTP=true
OUTBOX_POLL_MS=5000
